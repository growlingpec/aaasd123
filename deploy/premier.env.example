# Настройки Premier на сервере. Скопируйте в /etc/premier/premier.env и заполните.
# Файл читает только root и сервис — пароли и ключи не лежат в папке data/ и не попадают в бэкап.

# Пароль панели /panelp — от 12 символов. install.sh создаёт случайный.
# Если пусто или слишком простой — Premier сам создаст пароль и запишет его в /opt/premier/data/admin-password.txt
ADMIN_PASSWORD=

# Слушать только локально: снаружи сайт доступен только через Caddy/nginx (HTTPS)
HOST=127.0.0.1
PORT=3000

# Адрес сайта — для возврата после оплаты и входа через Google (без / в конце)
PUBLIC_URL=https://example.ru

# Ключи Platega (если заданы здесь — поля в панели блокируются)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Crypto Bot (@CryptoBot → Crypto Pay → My Apps → API Token). Можно не задавать здесь, а вписать в панели.
# CRYPTOPAY_TOKEN=
# CRYPTOPAY_TESTNET=1   # токен из @CryptoTestnetBot, для проверки без денег

# Вход через Google (console.cloud.google.com → Google Auth Platform → Clients).
# Redirect URI в Google: https://ВАШ-ДОМЕН/api/auth/google/callback
# Если поля пустые — кнопки «Войти через Google» нет.
GOOGLE_CLIENT_ID=1260644134-10l2percsm0emflbc33ocqethlfjrefd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Вход через GitHub (github.com → Settings → Developer settings → OAuth Apps).
# Callback URL в GitHub: https://ВАШ-ДОМЕН/api/auth/github/callback
# Если поля пустые — кнопки «Продолжить с GitHub» нет.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Python в Docker. Rootless Docker пользователя premier (см. DEPLOY.md, шаг 6):
# DOCKER_HOST=unix:///run/user/ID_ПОЛЬЗОВАТЕЛЯ/docker.sock
# Выключить выполнение кода совсем:
# CODE_RUNNER=off

# Облачный компьютер — свой Linux у пользователей платных тарифов (тот же Docker, что для Python).
# Образ: docker build -t premier-cloud -f sandbox/cloud.Dockerfile sandbox
# Адрес для сайтов, запущенных в облачном компьютере (отдельный поддомен, см. Caddyfile); без него сайты не открываются:
# CLOUD_PREVIEW_URL=https://pc.example.ru
# Без интернета в контейнерах:            CLOUD_NETWORK=none
# Выключить облачный компьютер:           CLOUD_RUNNER=off
# Лимиты: CLOUD_MEMORY=1g CLOUD_CPUS=1 CLOUD_MAX=10 (одновременно работающих) CLOUD_IDLE_MIN=20 CLOUD_MAX_MB=20480

# Chromium: sandbox включён по умолчанию; запускайте сервис НЕ от root.
# При ошибке sandbox сначала проверьте настройки user namespaces / AppArmor ОС.
# Автоматического перехода в небезопасный режим нет.
# Только для браузера в отдельно изолированном окружении, с пониманием риска:
# BROWSER_NO_SANDBOX=1
# Системный Chromium, если браузер Puppeteer не установлен:
# CHROMIUM_PATH=/usr/bin/chromium
# Число одновременно открытых вкладок: 1–8, по умолчанию 2.
# BROWSER_PAGES=2

# Максимум одного запроса к текстовой модели, включая чтение потока.
# По умолчанию 180000 мс (3 минуты), диапазон 1000–600000.
# Автоматическое завершение HTML — максимум один дополнительный запрос.
# Это ограничивает ожидание, но не ускоряет саму модель.
# MODEL_REQUEST_TIMEOUT_MS=180000

# Оповещения об ошибках и падениях (мониторинг). Бот: @BotFather → токен; чат: напишите боту и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там chat.id
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT=
# или свой адрес, куда придёт POST {"text": "..."}:
# ALERT_WEBHOOK_URL=
